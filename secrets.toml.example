# Copiá este archivo como secrets.toml (en local) o pegá su contenido en
# Streamlit Community Cloud > App > Settings > Secrets. NUNCA lo subas a GitHub.

APP_PASSWORD = "elegi-una-clave"           # contraseña para entrar a la app (recomendado si el link es público)
URL_DATOS_DEFAULT = "https://docs.google.com/spreadsheets/d/XXXXXXXX/edit"   # enlace que aparece precargado

# --- Envío del PDF por correo (opcional; sin estos datos el botón de envío no aparece) ---
# Ejemplo con Gmail: activar la verificación en dos pasos y crear una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Usar esa clave de 16 letras, no la contraseña habitual.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587                            # 587 = STARTTLS (por defecto) | 465 = SSL
SMTP_USER = "cuenta.del.club@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
# SMTP_REMITENTE = "Club Atlético Deportivo Riestra <cuenta.del.club@gmail.com>"   # opcional
# SMTP_SEGURIDAD = "starttls"              # opcional: "starttls" | "ssl" | "ninguna" (solo pruebas locales)
# EMAIL_DOMINIOS_PERMITIDOS = "riestra.com.ar, gmail.com"   # opcional: solo se envía a estos dominios
EMAIL_MAX_POR_SESION = 5                   # tope de envíos por visitante
